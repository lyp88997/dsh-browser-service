{
  "name": "dsh-browser-cdp",
  "version": "0.3.1",
  "description": "DSH browser provider backed by a self-hosted CDP browser service (browsersvc): reuses the built-in browser_* tool face",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./provider": "./lib/provider.js",
    "./dom": "./lib/dom.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyp88997/dsh-browser-service.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/lyp88997/dsh-browser-service/tree/main/plugin#readme",
  "bugs": {
    "url": "https://github.com/lyp88997/dsh-browser-service/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "browser",
    "cdp",
    "chrome-headless-shell",
    "playwright-core",
    "headless"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "playwright-core": "^1.49.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
