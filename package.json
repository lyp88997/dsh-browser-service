{
  "name": "dsh-browser-service",
  "version": "0.8.0",
  "description": "自建 DSH 浏览器服务：一个包 = 单例 CDP 守护进程 + 33 个 browser_* 工具面 + DSH ctx.browser provider（一个 dsh plugin add 装完即用）",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.19" },
  "bin": { "browsersvc": "bin/browsersvc.mjs" },
  "main": "./plugin/lib/index.js",
  "exports": {
    ".": "./plugin/lib/index.js",
    "./client": "./plugin/client.js",
    "./browser": "./plugin/shims/browser.js",
    "./tool-browser": "./plugin/shims/tool-browser.js",
    "./cordis.patch.yml": "./plugin/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./plugin/cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": { "type": "git", "url": "git+https://github.com/lyp88997/dsh-browser-service.git" },
  "homepage": "https://github.com/lyp88997/dsh-browser-service#readme",
  "bugs": { "url": "https://github.com/lyp88997/dsh-browser-service/issues" },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "browser", "cdp", "chrome-headless-shell", "playwright-core", "headless"],
  "files": ["bin", "src", "plugin", "tools", "docs", "scripts", "README.md", "LICENSE"],
  "scripts": {
    "start": "node bin/browsersvc.mjs start",
    "stop": "node bin/browsersvc.mjs stop",
    "status": "node bin/browsersvc.mjs status",
    "detect": "node bin/browsersvc.mjs detect",
    "verify": "node scripts/verify-daemon.mjs",
    "verify:provider": "node scripts/verify-provider.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "test": "node scripts/verify-daemon.mjs && node scripts/verify-provider.mjs"
  },
  "dependencies": {
    "dsh-builtin-browser": "^0.1.22",
    "playwright-core": "^1.49.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
